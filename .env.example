# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع .env إلى GitHub أبداً.
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=optional_test_guild_id
MONGODB_URI=optional_mongodb_connection_string
GITHUB_TOKEN=optional_for_remote_sync
# ===== الذكاء الاصطناعي للشات بوت (اختياري — بدونه يعمل بردود بسيطة) =====
GEMINI_API_KEY=your_gemini_key_from_aistudio
# عدة مفاتيح (موصى به لمنع التوقف) — تدوير تلقائي عند الضغط:
# GEMINI_API_KEYS=key1,key2,key3
# النماذج بالترتيب (الاحتياطي تلقائي): 
# AI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
# AI_MAX_CONCURRENT=3
# أو بدلاً منه:
# OPENAI_API_KEY=optional_openai_key
# OPENAI_MODEL=gpt-4o-mini

# Groq (احتياطي سريع للذكاء الاصطناعي)
GROQ_API_KEY=
# AI_PROVIDER_ORDER=groq-first
